# Server Configuration
PORT=3000
APP_URL=http://localhost:3000

# Brevo (formerly Sendinblue) SMTP Configuration (Recommended - 300 free emails/day)
# 1. Sign up / login at https://app.brevo.com
# 2. Go to https://app.brevo.com/settings/keys/smtp
# 3. Copy your Login into SMTP_USER
# 4. Click "Generate a new SMTP key" and paste it into SMTP_PASS
# 5. Set SMTP_FROM to your registered Brevo email
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_brevo_account_email@example.com
SMTP_PASS=xsmtpsib-your-generated-key
SMTP_FROM="OnMyWay (OMW)" <your_brevo_account_email@example.com>
