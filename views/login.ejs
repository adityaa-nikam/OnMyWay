<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Sign In — OnMyWay (OMW)</title>
  <link rel="stylesheet" href="/css/app.css" />
  <link rel="manifest" href="/manifest.json" />
  <meta name="theme-color" content="#ffffff" />
</head>
<body class="min-h-screen bg-background text-foreground flex flex-col items-center justify-center p-4 antialiased selection:bg-neutral-200">
  <div class="max-w-md w-full rounded-lg border border-border bg-card p-6 sm:p-8 shadow-sm">
    <div class="text-center mb-6">
      <div class="inline-flex items-center justify-center w-10 h-10 rounded-full border border-border bg-muted mb-3">
        <svg class="h-5 w-5 text-foreground" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
          <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon>
        </svg>
      </div>
      <h1 class="text-2xl font-semibold tracking-tight text-foreground">OnMyWay</h1>
      <p class="text-xs text-muted-foreground mt-1">Share until you arrive.</p>
    </div>

    <% if (sent) { %>
      <div class="rounded-lg border border-border bg-muted/40 p-5 mb-6 text-center">
        <div class="mx-auto mb-2 flex h-8 w-8 items-center justify-center rounded-full bg-muted border border-border">
          <svg class="h-4 w-4 text-foreground" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <rect width="20" height="16" x="2" y="4" rx="2"></rect>
            <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path>
          </svg>
        </div>
        <h3 class="text-sm font-semibold text-foreground">Magic Link Sent</h3>
        <p class="text-xs text-muted-foreground mt-1">
          Check your email for your one-click sign-in link. The link expires in 15 minutes.
        </p>

        <% if (devLink) { %>
          <div class="mt-4 pt-3 border-t border-border text-left">
            <span class="inline-block px-2 py-0.5 rounded text-[10px] font-semibold tracking-wider uppercase bg-muted text-muted-foreground border border-border mb-2">
              Local Dev Shortcut
            </span>
            <p class="text-[11px] text-muted-foreground mb-3">
              No SMTP server configured. Click below to sign in directly without checking terminal:
            </p>
            <a href="<%= devLink %>" class="inline-flex w-full h-9 items-center justify-center rounded-md bg-primary px-4 py-2 text-xs font-medium text-primary-foreground shadow transition-colors hover:bg-neutral-800 focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-ring">
              Click here to Sign In now →
            </a>
          </div>
        <% } else { %>
          <p class="text-[11px] text-muted-foreground mt-3">
            (If running locally, check your terminal output for the dev link)
          </p>
        <% } %>
      </div>

      <div class="text-center">
        <a href="/login" class="text-xs text-muted-foreground hover:text-foreground underline underline-offset-4">Use a different email</a>
      </div>
    <% } else { %>
      <% if (error) { %>
        <div class="rounded-md border border-border bg-muted/60 p-3 mb-4 text-xs text-foreground text-center font-medium">
          <%= error %>
        </div>
      <% } %>

      <form action="/auth/magic-link" method="POST" class="space-y-4">
        <input type="hidden" name="returnUrl" value="<%= returnUrl %>" />

        <div class="space-y-1.5">
          <label for="email" class="block text-xs font-medium text-foreground">
            Email address
          </label>
          <input type="email" id="email" name="email" required placeholder="name@example.com"
                 class="flex h-9 w-full rounded-md border border-input bg-transparent px-3 py-1 text-sm shadow-sm transition-colors placeholder:text-muted-foreground focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-ring disabled:cursor-not-allowed disabled:opacity-50" />
        </div>

        <button type="submit"
                class="inline-flex w-full h-9 items-center justify-center rounded-md bg-primary px-4 py-2 text-sm font-medium text-primary-foreground shadow transition-colors hover:bg-neutral-800 focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-ring">
          Send Magic Link
        </button>
      </form>

      <div class="mt-8 pt-6 border-t border-border text-center space-y-2">
        <p class="text-xs text-muted-foreground">
          Want to test without an account?
        </p>
        <a href="/" class="inline-flex items-center text-xs font-medium text-foreground hover:underline underline-offset-4 transition">
          Try Ephemeral Guest Mode (No sign-in required)
        </a>
      </div>
    <% } %>
  </div>
</body>
</html>
