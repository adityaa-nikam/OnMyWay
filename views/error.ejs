<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= typeof title !== 'undefined' ? title : 'Error' %> — OnMyWay</title>
  <link rel="stylesheet" href="/css/app.css" />
  <link rel="manifest" href="/manifest.json" />
  <meta name="theme-color" content="#ffffff" />
</head>
<body class="min-h-screen bg-background text-foreground flex flex-col items-center justify-center p-4 antialiased selection:bg-neutral-200">
  <div class="max-w-md w-full rounded-lg border border-border bg-card p-8 text-center shadow-sm">
    <div class="mx-auto mb-4 flex h-12 w-12 items-center justify-center rounded-full border border-border bg-muted">
      <svg class="h-6 w-6 text-foreground" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="12" cy="12" r="10"></circle>
        <line x1="12" y1="8" x2="12" y2="12"></line>
        <line x1="12" y1="16" x2="12.01" y2="16"></line>
      </svg>
    </div>
    <h1 class="text-xl font-semibold tracking-tight text-foreground"><%= typeof title !== 'undefined' ? title : 'Notice' %></h1>
    <p class="mt-2 text-sm text-muted-foreground"><%= typeof message !== 'undefined' ? message : 'An unexpected condition occurred.' %></p>
    
    <div class="mt-6 flex flex-col sm:flex-row gap-2 justify-center">
      <a href="/groups" class="inline-flex h-9 items-center justify-center rounded-md bg-primary px-4 py-2 text-sm font-medium text-primary-foreground shadow transition-colors hover:bg-neutral-800 focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-ring">
        Go to Groups
      </a>
      <a href="/" class="inline-flex h-9 items-center justify-center rounded-md border border-input bg-background px-4 py-2 text-sm font-medium transition-colors hover:bg-accent hover:text-accent-foreground focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-ring">
        Home
      </a>
    </div>
  </div>
</body>
</html>
