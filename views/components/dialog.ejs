<%#
  views/components/dialog.ejs
  shadcn/ui Dialog modal port using native accessible dialog / backdrop.
  Props:
    - id: string (required dialog element id)
    - title: string (dialog title)
    - description: string (dialog description)
    - content: string (raw HTML content)
    - footer: string (optional raw HTML footer actions)
    - className: string (optional)
%>
<%
  const dlgId = typeof id !== 'undefined' ? id : 'dialog_' + Math.random().toString(36).slice(2, 8);
  const dlgTitle = typeof title !== 'undefined' ? title : '';
  const dlgDesc = typeof description !== 'undefined' ? description : '';
  const dlgContent = typeof content !== 'undefined' ? content : '';
  const dlgFooter = typeof footer !== 'undefined' ? footer : '';
  const extra = typeof className !== 'undefined' ? className : '';
%>
<div id="<%= dlgId %>"
     role="dialog"
     aria-modal="true"
     aria-labelledby="<%= dlgId %>-title"
     aria-describedby="<%= dlgId %>-desc"
     class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/40 backdrop-blur-sm hidden data-[state=open]:flex data-[state=closed]:hidden">
  
  <div data-dialog-card
       class="relative w-full max-w-lg rounded-lg border border-border bg-card p-6 shadow-popover duration-150 animate-in fade-in-0 zoom-in-95 <%= extra %>">
    
    <!-- Close Icon Button -->
    <button type="button"
            data-dialog-close="<%= dlgId %>"
            aria-label="Close dialog"
            class="absolute right-4 top-4 rounded-sm opacity-70 ring-offset-background transition-opacity hover:opacity-100 focus:outline-none focus:ring-2 focus:ring-ring focus:ring-offset-2 cursor-pointer">
      <svg class="lucide lucide-sm" aria-hidden="true"><use href="/icons/sprite.svg#x"></use></svg>
    </button>

    <!-- Header -->
    <div class="flex flex-col space-y-1.5 text-center sm:text-left mb-4">
      <% if (dlgTitle) { %>
        <h2 id="<%= dlgId %>-title" class="text-lg font-semibold leading-none tracking-tight"><%= dlgTitle %></h2>
      <% } %>
      <% if (dlgDesc) { %>
        <p id="<%= dlgId %>-desc" class="text-sm text-muted-foreground"><%= dlgDesc %></p>
      <% } %>
    </div>

    <!-- Body Content -->
    <div class="py-2 text-sm text-foreground">
      <%- dlgContent %>
    </div>

    <!-- Footer Actions -->
    <% if (dlgFooter) { %>
      <div class="flex flex-col-reverse sm:flex-row sm:justify-end sm:space-x-2 pt-4 border-t border-border mt-4">
        <%- dlgFooter %>
      </div>
    <% } %>
  </div>
</div>
