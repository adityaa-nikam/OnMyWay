<%#
  views/components/alert.ejs
  shadcn/ui Alert message port.
  Variants:
    - variant: "default" | "destructive"
  Props:
    - title: string (optional)
    - description: string (required)
    - icon: string (optional Lucide icon name)
    - variant: string (default "default")
    - className: string (optional)
%>
<%
  const v = typeof variant !== 'undefined' ? variant : 'default';
  const alertTitle = typeof title !== 'undefined' ? title : '';
  const alertDesc = typeof description !== 'undefined' ? description : '';
  const alertIcon = typeof icon !== 'undefined' ? icon : (v === 'destructive' ? 'alert-triangle' : 'info');
  const extra = typeof className !== 'undefined' ? className : '';

  const variantClasses = {
    default: "bg-background text-foreground border-border",
    destructive: "border-destructive/50 text-destructive dark:border-destructive [&>svg]:text-destructive"
  }[v] || "bg-background text-foreground border-border";
%>
<div role="alert" class="relative w-full rounded-lg border p-4 [&>svg~*]:pl-7 [&>svg+div]:translate-y-[-3px] [&>svg]:absolute [&>svg]:left-4 [&>svg]:top-4 [&>svg]:text-foreground <%= variantClasses %> <%= extra %>">
  <% if (alertIcon) { %>
    <svg class="lucide" aria-hidden="true"><use href="/icons/sprite.svg#<%= alertIcon %>"></use></svg>
  <% } %>
  <div>
    <% if (alertTitle) { %>
      <h5 class="mb-1 font-medium leading-none tracking-tight"><%= alertTitle %></h5>
    <% } %>
    <div class="text-sm opacity-90 leading-relaxed"><%= alertDesc %></div>
  </div>
</div>
