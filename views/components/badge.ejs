<%#
  views/components/badge.ejs
  shadcn/ui Badge port in vanilla EJS.
  Variants:
    - variant: "default" | "secondary" | "outline" | "destructive"
  Props:
    - text: string (label)
    - variant: string (default "default")
    - icon: string (optional Lucide icon name)
    - className: string (optional)
%>
<%
  const v = typeof variant !== 'undefined' ? variant : 'default';
  const labelText = typeof text !== 'undefined' ? text : '';
  const extra = typeof className !== 'undefined' ? className : '';

  const variantClasses = {
    default: "border-transparent bg-primary text-primary-foreground hover:bg-primary/80",
    secondary: "border-transparent bg-secondary text-secondary-foreground hover:bg-secondary/80",
    destructive: "border-transparent bg-destructive text-destructive-foreground hover:bg-destructive/80",
    outline: "text-foreground border-border"
  }[v] || "border-transparent bg-primary text-primary-foreground";

  const classes = "inline-flex items-center gap-1.5 rounded-full border px-2.5 py-0.5 text-xs font-semibold transition-colors focus:outline-none focus:ring-2 focus:ring-ring focus:ring-offset-2 " + variantClasses + " " + extra;
%>
<span class="<%= classes %>">
  <% if (typeof icon !== 'undefined' && icon) { %>
    <svg class="lucide lucide-sm" aria-hidden="true"><use href="/icons/sprite.svg#<%= icon %>"></use></svg>
  <% } %>
  <span><%= labelText %></span>
</span>
