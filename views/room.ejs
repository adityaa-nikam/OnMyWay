<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
  <title><%= typeof group !== 'undefined' ? group.name + ' — OnMyWay (OMW)' : 'OnMyWay (OMW) — Share until you arrive' %></title>
  <meta http-equiv="Cache-Control" content="no-cache, no-store, must-revalidate" />
  <meta http-equiv="Pragma" content="no-cache" />
  <meta http-equiv="Expires" content="0" />
  <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
  <link rel="stylesheet" href="/CSS/room.css?v=<%= Date.now() %>" />
  <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
  <script>
    window.__OMW_CONFIG__ = {
      isPersistentGroup: <%= typeof isPersistentGroup !== 'undefined' && isPersistentGroup ? 'true' : 'false' %>,
      groupId: "<%= typeof groupId !== 'undefined' ? groupId : '' %>",
      groupName: "<%= typeof group !== 'undefined' ? group.name.replace(/"/g, '\\"') : '' %>",
      currentUser: <%- typeof user !== 'undefined' && user ? JSON.stringify(user) : 'null' %>,
      csrfToken: "<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>"
    };
  </script>
  <script defer src="/socket.io/socket.io.js"></script>
  <script defer src="/JS/room.js?v=<%= Date.now() %>"></script>
</head>
<body class="theme-dark">
  <!-- Top Navigation Header -->
  <header class="app-header">
    <div class="header-left">
      <a href="<%= typeof isPersistentGroup !== 'undefined' && isPersistentGroup ? '/groups' : '/' %>" class="brand-link" title="Return to home">
        <span class="brand-icon">⚡</span>
        <span class="brand-title">OnMyWay <span class="brand-subtitle">(OMW)</span></span>
      </a>

      <% if (typeof isPersistentGroup !== 'undefined' && isPersistentGroup) { %>
        <div class="room-pill group-pill">
          <span class="room-label">GROUP:</span>
          <span class="room-id font-mono"><%= group.name %></span>
          <button id="group-invite-btn" class="icon-btn" title="Create Invite Link" onclick="openInviteModal()">
            🔗 <span class="btn-text">Invite</span>
          </button>
        </div>
      <% } else { %>
        <div class="room-pill">
          <span class="room-label">GUEST:</span>
          <span id="header-room-id" class="room-id font-mono">Loading...</span>
          <button id="copy-invite-btn" class="icon-btn" title="Copy Invite Link" onclick="copyInviteLink()">
            📋 <span class="btn-text">Copy Link</span>
          </button>
        </div>
      <% } %>
    </div>

    <div class="header-right">
      <div id="connection-status" class="status-pill status-connecting">
        <span class="status-dot"></span>
        <span id="connection-text" class="status-text">Connecting...</span>
      </div>
      <button id="leave-room-btn" class="leave-btn" onclick="leaveRoom()">
        Leave
      </button>
    </div>
  </header>

  <!-- Mobile View Switcher (Visible only on small screens) -->
  <nav class="mobile-tabs" aria-label="Mobile View Switcher">
    <button id="tab-btn-map" class="tab-btn active" onclick="switchMobileTab('map')">
      📍 Map & GPS (<span id="mobile-sharer-count">0</span>)
    </button>
    <button id="tab-btn-chat" class="tab-btn" onclick="switchMobileTab('chat')">
      💬 Chat
    </button>
    <button id="tab-btn-members" class="tab-btn" onclick="switchMobileTab('members')">
      👥 People (<span id="mobile-member-count">0</span>)
    </button>
  </nav>

  <!-- Main Workspace Layout -->
  <main class="workspace-container">
    <!-- Left Panel: Participants & Presence Sidebar -->
    <aside id="panel-members" class="sidebar-panel">
      <div class="panel-header">
        <h3>Participants</h3>
        <span id="sidebar-member-count" class="badge">0</span>
      </div>
      <ul id="participant-list" class="participant-list" aria-label="Room Participants">
        <!-- Dynamically populated safely with textContent -->
      </ul>
      <div class="sidebar-footer">
        <span class="text-muted text-xs">Room isolated & crypto secured</span>
      </div>
    </aside>

    <!-- Center/Right Panel: Interactive Leaflet Map -->
    <section id="panel-map" class="map-panel">
      <!-- Error / Permission Alert Banner -->
      <div id="geo-error-banner" class="geo-banner hidden">
        <span id="geo-error-text" class="banner-text"></span>
        <button class="banner-close" onclick="dismissGeoError()">✕</button>
      </div>

      <!-- Map Overlay Controls -->
      <div class="map-controls-bar">
        <div id="sharing-pill" class="sharing-status-pill hidden">
          <span class="live-dot"></span>
          <span id="live-status-text" class="live-text">Live GPS Active</span>
          <span id="share-countdown" class="share-countdown">15:00</span>
          <button id="btn-extend-share" class="btn-pill-extend" onclick="extendActiveShare()" title="Add 15 minutes">+15m</button>
          <button id="btn-stop-pill" class="btn-pill-stop" onclick="stopLocationSharing()" title="Stop sharing location">✕</button>
        </div>

        <button id="btn-start-location" class="ctrl-btn btn-share" onclick="openShareSetupModal()">
          📍 Share My Location
        </button>

        <button id="btn-stop-location" class="ctrl-btn btn-stop hidden" onclick="stopLocationSharing()">
          ⏹ Stop Sharing
        </button>

        <button id="btn-share-log" class="ctrl-btn btn-share-log" onclick="openShareLogModal()" title="View Location Sharing History">
          📋 Share Log
        </button>

        <button id="btn-ghost-toggle" class="ctrl-btn btn-ghost" onclick="toggleGhostMode()" title="Toggle Ghost Mode (Fuzz location by ~300m)">
          👻 Ghost: OFF
        </button>

        <button id="btn-set-meetup" class="ctrl-btn btn-meetup" onclick="toggleMeetingPointMode()" title="Click on map to drop a shared meeting point">
          🎯 Meet Here
        </button>

        <button id="btn-recenter" class="ctrl-btn btn-recenter" onclick="recenterMap()" title="Center on my location">
          🎯 Center On Me
        </button>

        <!-- Emergency SOS Button with 3-Second Hold-to-Confirm & Radial Progress Ring -->
        <div class="sos-hold-container" title="Hold for 3 seconds to trigger Emergency SOS">
          <button id="btn-sos" type="button" class="ctrl-btn btn-sos btn-sos-hold">
            <svg class="sos-radial-svg" viewBox="0 0 36 36">
              <path class="sos-radial-bg" d="M18 2.0845 a 15.9155 15.9155 0 0 1 0 31.831 a 15.9155 15.9155 0 0 1 0 -31.831"/>
              <path id="sos-radial-progress" class="sos-radial-progress" stroke-dasharray="0, 100" d="M18 2.0845 a 15.9155 15.9155 0 0 1 0 31.831 a 15.9155 15.9155 0 0 1 0 -31.831"/>
            </svg>
            <span class="sos-label">🚨 Hold SOS</span>
          </button>
        </div>

        <button id="btn-tile-toggle" class="ctrl-btn btn-tile" onclick="toggleMapTiles()" title="Toggle Dark/Light Map Style">
          ☀️ Light Map
        </button>
      </div>

      <!-- Shared Rendezvous Point Banner -->
      <div id="rendezvous-banner" class="rendezvous-banner hidden">
        <span class="rendezvous-icon">🎯</span>
        <div class="rendezvous-info">
          <div id="rendezvous-label" class="rendezvous-title">Meet at: Meeting Point</div>
          <div id="rendezvous-distance" class="rendezvous-dist">Calculating distance...</div>
        </div>
        <div class="rendezvous-actions">
          <button class="action-sm" onclick="focusRendezvous()" title="Zoom to meeting point">Zoom</button>
          <button class="action-sm danger" onclick="clearMeetingPoint()" title="Clear meeting point">✕</button>
        </div>
      </div>

      <!-- Emergency SOS Banner (Interactive with 'I'm on it' and 'False alarm') -->
      <div id="sos-alert-banner" class="sos-banner hidden">
        <div class="sos-content">
          <span class="sos-icon">🚨</span>
          <div class="sos-details">
            <span id="sos-alert-text" class="sos-text">EMERGENCY: Participant triggered SOS Beacon!</span>
            <div id="sos-responders-list" class="sos-responders-text"></div>
          </div>
        </div>
        <div class="sos-banner-actions">
          <button id="btn-sos-respond" class="btn-sos-action btn-on-it" onclick="respondToActiveSos()">🛡️ I'm on it</button>
          <button id="btn-sos-cancel" class="btn-sos-action btn-false-alarm hidden" onclick="cancelActiveSos()">✅ False alarm</button>
          <button class="sos-close" onclick="dismissSosBanner()">✕</button>
        </div>
      </div>

      <!-- Proximity Toast Notification -->
      <div id="proximity-toast" class="proximity-toast hidden">
        <span class="proximity-icon">🎉</span>
        <span id="proximity-toast-text" class="proximity-text">You and a friend are close!</span>
      </div>

      <!-- Leaflet Map Container -->
      <div id="map"></div>
    </section>

    <!-- Right Panel: Integrated Chat Feed -->
    <section id="panel-chat" class="chat-panel">
      <div class="panel-header chat-header">
        <h3>Group Chat</h3>
        <span id="chat-status-indicator" class="text-xs text-muted">Room-isolated</span>
      </div>

      <!-- Message History Container -->
      <div id="chat-messages" class="chat-messages" role="log" aria-live="polite">
        <!-- Message bubbles populated safely via textContent -->
      </div>

      <!-- Quick Action Status Chips (Calm voice, opt-in location pin) -->
      <div class="chat-chips-container">
        <div class="chat-chips-scroll" aria-label="Status Chips">
          <button type="button" class="action-chip" onclick="sendStatusChip('On my way', 'on_my_way')">🚗 On my way</button>
          <button type="button" class="action-chip" onclick="sendStatusChip('Running late', 'running_late')">⏳ Running late</button>
          <button type="button" class="action-chip" onclick="sendStatusChip('Reached safe', 'reached_safe')">🏡 Reached safe</button>
          <button type="button" class="action-chip danger" onclick="sendStatusChip('Need help', 'need_help')">🆘 Need help</button>
        </div>
        <div class="chip-attach-bar">
          <label class="chip-attach-toggle">
            <input type="checkbox" id="attach-location-toggle" />
            <span>Attach my location pin (24h retention)</span>
          </label>
        </div>
      </div>

      <!-- Message Input Form -->
      <form id="chat-form" class="chat-input-bar" onsubmit="handleSendMessage(event)">
        <input id="chat-input" type="text" placeholder="Type a message..." maxlength="2000" autocomplete="off" />
        <button type="submit" id="chat-send-btn" class="send-btn" aria-label="Send Message">
          Send
        </button>
      </form>
    </section>
  </main>

  <!-- Join Room / Display Name Modal -->
  <div id="join-modal" class="modal-overlay hidden">
    <div class="modal-card">
      <div class="modal-header">
        <span class="modal-icon">👋</span>
        <h2>Join Private Room</h2>
        <p class="modal-subtitle">Enter your display name to enter the coordination workspace</p>
      </div>
      <form id="join-room-form" onsubmit="handleJoinModalSubmit(event)">
        <div class="form-group">
          <label for="display-name-input">Display Name</label>
          <input id="display-name-input" type="text" placeholder="e.g. Alex" maxlength="30" required autofocus autocomplete="nickname" />
          <span class="field-hint">Max 30 characters. Duplicate names will automatically be disambiguated.</span>
        </div>
        <div id="join-error-msg" class="modal-error hidden"></div>
        <button type="submit" id="btn-submit-join" class="btn-primary-large">
          Join Workspace
        </button>
      </form>
    </div>
  </div>

  <!-- Invalid Invitation Error Modal -->
  <div id="invalid-room-modal" class="modal-overlay hidden">
    <div class="modal-card text-center">
      <div class="modal-icon text-danger">⚠️</div>
      <h2 id="invalid-title">Invalid Invitation</h2>
      <p id="invalid-description" class="modal-subtitle">
        This room does not exist, has expired, or the invitation token is invalid.
      </p>
      <a href="/" class="btn-primary-large inline-block">Return to Home</a>
    </div>
  </div>

  <!-- Persistent Group Invite Modal -->
  <div id="invite-modal" class="modal-overlay hidden">
    <div class="modal-card">
      <div class="modal-header">
        <span class="modal-icon">🔗</span>
        <h2>Invite to Group</h2>
        <p class="modal-subtitle">Generate a secure invitation link for your group</p>
      </div>

      <div class="form-group">
        <label for="invite-hours-select">Link Expiration</label>
        <select id="invite-hours-select" class="form-input">
          <option value="24" selected>Expires in 24 hours</option>
          <option value="72">Expires in 3 days</option>
          <option value="168">Expires in 7 days</option>
          <option value="720">Expires in 30 days</option>
        </select>
      </div>

      <div class="form-group">
        <label for="invite-max-uses">Max Uses (Optional)</label>
        <input id="invite-max-uses" type="number" min="1" max="1000" placeholder="Unlimited uses if empty" class="form-input" />
      </div>

      <div id="generated-invite-box" class="hidden" style="margin-top: 12px; padding: 12px; background: rgba(0,0,0,0.3); border-radius: 8px; border: 1px solid rgba(255,255,255,0.1);">
        <label style="font-size: 0.75rem; color: #94a3b8; display: block; margin-bottom: 6px;">Your Invitation Link:</label>
        <div style="display: flex; gap: 6px;">
          <input id="generated-invite-input" type="text" readonly style="flex: 1; background: #0b1120; border: 1px solid rgba(255,255,255,0.15); color: #38bdf8; padding: 6px 10px; border-radius: 6px; font-family: monospace; font-size: 0.8rem;" />
          <button id="copy-generated-invite-btn" onclick="copyGeneratedInvite()" class="icon-btn" style="padding: 6px 12px;">Copy</button>
        </div>
      </div>

      <div style="display: flex; justify-content: flex-end; gap: 8px; margin-top: 20px;">
        <button type="button" onclick="closeInviteModal()" class="action-sm" style="padding: 8px 16px;">Close</button>
        <button type="button" id="btn-create-invite" onclick="handleCreateInvite()" class="btn-primary-large" style="width: auto; padding: 8px 20px; font-size: 0.85rem;">Generate Link</button>
      </div>
    </div>
  </div>

  <!-- Time-Boxed Share Setup Modal -->
  <div id="share-setup-modal" class="modal-overlay hidden">
    <div class="modal-card">
      <div class="modal-header">
        <span class="modal-icon">📍</span>
        <h2>Share My Location</h2>
        <p class="modal-subtitle">Pick how long to share and choose your audience</p>
      </div>

      <!-- Duration Selection -->
      <div class="form-group">
        <label class="block text-xs uppercase tracking-wider text-slate-400 mb-2 font-bold">Duration</label>
        <div class="duration-grid">
          <label class="duration-card">
            <input type="radio" name="share-duration" value="15m" checked onchange="handleDurationChange('15m')" />
            <span class="duration-badge">⏱️ 15 min</span>
            <span class="duration-desc">Quick errand</span>
          </label>
          <label class="duration-card">
            <input type="radio" name="share-duration" value="1h" onchange="handleDurationChange('1h')" />
            <span class="duration-badge">⏳ 1 hour</span>
            <span class="duration-desc">Commute or trip</span>
          </label>
          <label class="duration-card">
            <input type="radio" name="share-duration" value="8h" onchange="handleDurationChange('8h')" />
            <span class="duration-badge">🏔️ 8 hours</span>
            <span class="duration-desc">Day hike or work</span>
          </label>
          <label class="duration-card">
            <input type="radio" name="share-duration" value="until_arrive" onchange="handleDurationChange('until_arrive')" />
            <span class="duration-badge">🎯 Until I arrive</span>
            <span class="duration-desc">Stops at destination</span>
          </label>
          <label class="duration-card">
            <input type="radio" name="share-duration" value="until_stop" onchange="handleDurationChange('until_stop')" />
            <span class="duration-badge">⏹️ Until I stop</span>
            <span class="duration-desc">Manual stop only</span>
          </label>
        </div>
      </div>

      <!-- Destination picker (visible when 'until_arrive' is chosen) -->
      <div id="destination-input-group" class="form-group hidden">
        <label for="destination-name-input">Destination Name</label>
        <input id="destination-name-input" type="text" placeholder="e.g. Home, Trailhead, Work" class="form-input" />
        <span class="field-hint">Your live location will stop sharing automatically when you reach within 100m.</span>
      </div>

      <!-- Audience Control: Target Groups -->
      <div class="form-group" style="margin-top: 14px;">
        <label class="block text-xs uppercase tracking-wider text-slate-400 mb-2 font-bold">Audience (Who can see you?)</label>
        <div id="share-audience-list" class="audience-list">
          <span class="text-xs text-slate-400">Loading your groups...</span>
        </div>
      </div>

      <div style="display: flex; justify-content: flex-end; gap: 8px; margin-top: 20px;">
        <button type="button" onclick="closeShareSetupModal()" class="action-sm" style="padding: 8px 16px;">Cancel</button>
        <button type="button" id="btn-confirm-start-share" onclick="confirmStartSharing()" class="btn-primary-large" style="width: auto; padding: 8px 20px; font-size: 0.85rem;">Start Sharing</button>
      </div>
    </div>
  </div>

  <!-- Share History Log Modal -->
  <div id="share-log-modal" class="modal-overlay hidden">
    <div class="modal-card">
      <div class="modal-header">
        <span class="modal-icon">📋</span>
        <h2>Location Sharing Log</h2>
        <p class="modal-subtitle">Transparent record of when you started, extended, and stopped sharing</p>
      </div>

      <div id="share-log-list" class="share-log-container">
        <span class="text-xs text-slate-400">Loading activity log...</span>
      </div>

      <div style="display: flex; justify-content: flex-end; margin-top: 20px;">
        <button type="button" onclick="closeShareLogModal()" class="action-sm" style="padding: 8px 16px;">Close</button>
      </div>
    </div>
  </div>
</body>
</html>
