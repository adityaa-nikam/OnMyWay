  <!-- Interactive Demo SOS Hold Logic -->
  <script>
    document.addEventListener('DOMContentLoaded', () => {
      const sosBtn = document.getElementById('demo-sos-btn');
      const sosCircle = document.querySelector('#demo-sos-ring [data-progress-circle]');
      const sosStatus = document.getElementById('demo-sos-status');
      if (!sosBtn || !sosCircle || !sosStatus) return;

      let holdTimer = null;
      let startTime = null;
      let animFrame = null;
      const HOLD_DURATION = 3000;
      const circumference = parseFloat(sosCircle.getAttribute('stroke-dasharray')) || 150;

      function updateProgress() {
        if (!startTime) return;
        const elapsed = Date.now() - startTime;
        const pct = Math.min(elapsed / HOLD_DURATION, 1);
        const offset = circumference - pct * circumference;
        sosCircle.style.strokeDashoffset = offset;

        if (pct < 1) {
          sosStatus.textContent = 'Hold: ' + Math.ceil((HOLD_DURATION - elapsed) / 1000) + 's remaining...';
          animFrame = requestAnimationFrame(updateProgress);
        } else {
          sosStatus.textContent = '🚨 SOS TRIGGERED!';
          sosStatus.classList.add('text-destructive');
          window.toast({
            title: 'Emergency SOS Activated',
            description: 'Hold requirement met. Emergency beacon sent.',
            variant: 'destructive'
          });
          resetProgress();
        }
      }

      function startHold(e) {
        e.preventDefault();
        startTime = Date.now();
        animFrame = requestAnimationFrame(updateProgress);
      }

      function resetProgress() {
        if (animFrame) cancelAnimationFrame(animFrame);
        startTime = null;
        sosCircle.style.strokeDashoffset = circumference;
        setTimeout(() => {
          sosStatus.textContent = 'Hold button for 3 seconds';
          sosStatus.classList.remove('text-destructive');
        }, 1500);
      }

      sosBtn.addEventListener('mousedown', startHold);
      sosBtn.addEventListener('touchstart', startHold);
      window.addEventListener('mouseup', resetProgress);
      window.addEventListener('touchend', resetProgress);
    });
  </script>
</body>
</html>
