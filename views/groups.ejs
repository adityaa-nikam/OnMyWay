<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>My Groups — OnMyWay (OMW)</title>
  <link rel="stylesheet" href="/css/app.css" />
  <link rel="manifest" href="/manifest.json" />
  <meta name="theme-color" content="#ffffff" />
</head>
<body class="min-h-screen bg-background text-foreground p-4 md:p-8 font-sans antialiased selection:bg-neutral-200">
  <div class="max-w-4xl mx-auto">
    <!-- Top Navigation Header -->
    <header class="flex items-center justify-between pb-6 mb-8 border-b border-border">
      <div class="flex items-center gap-3">
        <a href="/" class="flex items-center gap-2.5">
          <div class="w-8 h-8 rounded-md border border-border bg-muted flex items-center justify-center">
            <svg class="h-4 w-4 text-foreground" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon>
            </svg>
          </div>
          <div>
            <h1 class="text-base font-semibold text-foreground tracking-tight">OnMyWay</h1>
            <p class="text-[11px] text-muted-foreground">Share until you arrive.</p>
          </div>
        </a>
      </div>

      <div class="flex items-center gap-3">
        <div class="hidden sm:flex items-center gap-2 border border-border bg-muted/40 px-3 py-1 rounded-md text-xs">
          <span class="w-1.5 h-1.5 rounded-full bg-foreground"></span>
          <span class="text-foreground font-medium"><%= user.displayName %></span>
        </div>
        <a href="/account" class="text-xs font-medium text-muted-foreground hover:text-foreground px-2.5 py-1.5 rounded-md hover:bg-muted transition-colors">
          Account
        </a>
        <form action="/auth/logout" method="POST" class="inline">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
          <button type="submit" class="text-xs font-medium text-muted-foreground hover:text-destructive px-2.5 py-1.5 rounded-md hover:bg-muted transition-colors">
            Sign Out
          </button>
        </form>
      </div>
    </header>

    <!-- Main Content Area -->
    <main>
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-8">
        <div>
          <h2 class="text-2xl font-semibold text-foreground tracking-tight">Your Groups</h2>
          <p class="text-xs text-muted-foreground mt-0.5">Persistent group coordination workspaces</p>
        </div>

        <div class="flex items-center gap-2.5">
          <button id="btn-open-join-modal"
                  class="sleek-btn-secondary h-9 px-4 text-xs font-medium">
            Join with Code
          </button>
          <button id="btn-open-create-modal"
                  class="sleek-btn-primary h-9 px-4 text-xs font-medium">
            + New Group
          </button>
        </div>
      </div>

      <!-- Groups List / Empty State -->
      <% if (groups.length === 0) { %>
        <div class="sleek-card rounded-xl border border-border bg-card p-12 text-center">
          <div class="mx-auto mb-3.5 flex h-11 w-11 items-center justify-center rounded-xl border border-border bg-muted/60">
            <svg class="h-5 w-5 text-muted-foreground" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"></path>
              <circle cx="9" cy="7" r="4"></circle>
              <path d="M22 21v-2a4 4 0 0 0-3-3.87"></path>
              <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
            </svg>
          </div>
          <h3 class="text-sm font-semibold text-foreground mb-1">No groups yet</h3>
          <p class="text-xs text-muted-foreground max-w-sm mx-auto mb-6">
            Create your first persistent group to start sharing locations and messages with friends, teammates, or family.
          </p>
          <button onclick="document.getElementById('dialog-create').showModal()"
                  class="sleek-btn-primary h-9 px-4 text-xs font-medium">
            Create a Group
          </button>
        </div>
      <% } else { %>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <% groups.forEach(function(g) { %>
            <div class="sleek-card rounded-xl p-5 flex flex-col justify-between">
              <div>
                <div class="flex items-start justify-between gap-2 mb-2">
                  <h3 class="text-sm font-semibold text-foreground truncate"><%= g.name %></h3>
                  <span class="inline-flex items-center rounded-md border border-border px-2 py-0.5 text-[10px] font-medium text-foreground bg-muted/60 uppercase tracking-wider">
                    <%= g.role %>
                  </span>
                </div>
                <div class="flex items-center gap-4 text-xs text-muted-foreground mb-6">
                  <span class="flex items-center gap-1.5">
                    <svg class="h-3.5 w-3.5 text-muted-foreground" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/></svg>
                    <%= g.member_count %> <%= g.member_count === 1 ? 'member' : 'members' %>
                  </span>
                  <span class="flex items-center gap-1.5">
                    <svg class="h-3.5 w-3.5 text-muted-foreground" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
                    <%= g.total_messages %> <%= g.total_messages === 1 ? 'message' : 'messages' %>
                  </span>
                  <% if (g.unread_count && g.unread_count > 0) { %>
                    <span class="inline-flex items-center rounded-full bg-foreground text-background text-[10px] font-semibold px-2 py-0.5">
                      <%= g.unread_count %> new
                    </span>
                  <% } %>
                </div>
              </div>

              <div class="flex items-center justify-between pt-4 border-t border-border/80">
                <span class="text-[11px] text-muted-foreground font-mono">#<%= g.id.slice(0, 8) %></span>
                <a href="/groups/<%= g.id %>"
                   class="sleek-btn-secondary h-8 px-3 text-xs font-medium">
                  Open Workspace →
                </a>
              </div>
            </div>
          <% }); %>
        </div>
      <% } %>

      <!-- Ephemeral Quick Room Link -->
      <div class="mt-12 p-5 rounded-xl border border-border/80 bg-muted/30 flex flex-col sm:flex-row items-center justify-between gap-4">
        <div>
          <h4 class="text-xs font-semibold text-foreground">
            Ephemeral Guest Mode
          </h4>
          <p class="text-xs text-muted-foreground mt-0.5">
            Need a quick coordination session without any database history?
          </p>
        </div>
        <a href="/" class="sleek-btn-secondary h-8 px-3.5 text-xs font-medium shrink-0">
          Start Ephemeral Room
        </a>
      </div>
    </main>
  </div>

  <!-- Native Modal: Create Group -->
  <dialog id="dialog-create" class="rounded-lg border border-border bg-card p-6 shadow-lg backdrop:bg-black/40 backdrop:backdrop-blur-sm max-w-md w-full">
    <div class="flex items-center justify-between mb-4">
      <h3 class="text-sm font-semibold text-foreground">Create New Group</h3>
      <button onclick="document.getElementById('dialog-create').close()" class="text-muted-foreground hover:text-foreground text-sm">✕</button>
    </div>

    <form id="form-create-group" class="space-y-4">
      <div class="space-y-1.5">
        <label class="block text-xs font-medium text-foreground">Group Name</label>
        <input type="text" id="create-group-name" required placeholder="e.g. Weekend Trek / Roadtrip"
               class="flex h-9 w-full rounded-md border border-input bg-transparent px-3 py-1 text-sm shadow-sm transition-colors placeholder:text-muted-foreground focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-ring" />
      </div>

      <div class="space-y-1.5">
        <label class="block text-xs font-medium text-foreground">Chat History Retention</label>
        <select id="create-group-retention" class="flex h-9 w-full rounded-md border border-input bg-background px-3 py-1 text-sm shadow-sm transition-colors focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-ring">
          <option value="30">Keep messages for 30 days</option>
          <option value="90">Keep messages for 90 days</option>
          <option value="365">Keep messages for 1 year</option>
          <option value="0">Never delete messages</option>
        </select>
      </div>

      <div class="flex justify-end gap-2 pt-2">
        <button type="button" onclick="document.getElementById('dialog-create').close()"
                class="sleek-btn-secondary h-9 px-4 text-xs font-medium">
          Cancel
        </button>
        <button type="submit"
                class="sleek-btn-primary h-9 px-4 text-xs font-medium">
          Create Group
        </button>
      </div>
    </form>
  </dialog>

  <!-- Native Modal: Join Group with Code -->
  <dialog id="dialog-join" class="rounded-xl border border-border bg-card p-6 shadow-xl backdrop:bg-black/45 backdrop:backdrop-blur-sm max-w-md w-full">
    <div class="flex items-center justify-between mb-4">
      <h3 class="text-sm font-semibold text-foreground">Join with Invite Code</h3>
      <button onclick="document.getElementById('dialog-join').close()" class="text-muted-foreground hover:text-foreground text-sm">✕</button>
    </div>

    <form id="form-join-group" class="space-y-4">
      <div class="space-y-1.5">
        <label class="block text-xs font-medium text-foreground">Invite Link or Token Code</label>
        <input type="text" id="join-invite-token" required placeholder="Paste full link or token code"
               class="flex h-10 w-full rounded-md border border-input bg-transparent px-3 py-1 text-sm shadow-xs transition-all placeholder:text-muted-foreground focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-ring" />
      </div>

      <div class="flex justify-end gap-2 pt-2">
        <button type="button" onclick="document.getElementById('dialog-join').close()"
                class="sleek-btn-secondary h-9 px-4 text-xs font-medium">
          Cancel
        </button>
        <button type="submit"
                class="sleek-btn-primary h-9 px-4 text-xs font-medium">
          Join Group
        </button>
      </div>
    </form>
  </dialog>

  <script>
    document.getElementById('btn-open-create-modal')?.addEventListener('click', () => {
      document.getElementById('dialog-create')?.showModal();
    });

    document.getElementById('btn-open-join-modal')?.addEventListener('click', () => {
      document.getElementById('dialog-join')?.showModal();
    });

    document.getElementById('form-create-group')?.addEventListener('submit', async function(e) {
      e.preventDefault();
      const name = document.getElementById('create-group-name').value.trim();
      const retention = document.getElementById('create-group-retention').value;
      if (!name) return;

      try {
        const res = await fetch('/api/groups', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            'X-CSRF-Token': '<%= csrfToken %>'
          },
          body: JSON.stringify({ name, messageRetentionDays: retention })
        });
        const data = await res.json();
        if (data.success) {
          window.location.href = '/groups/' + data.group.id;
        } else {
          alert(data.error || 'Failed to create group');
        }
      } catch (err) {
        alert('Network error while creating group');
      }
    });

    document.getElementById('form-join-group')?.addEventListener('submit', function(e) {
      e.preventDefault();
      let raw = document.getElementById('join-invite-token').value.trim();
      if (!raw) return;

      if (raw.includes('/join-group/')) {
        raw = raw.split('/join-group/')[1].split(/[?#]/)[0];
      }
      window.location.href = '/join-group/' + encodeURIComponent(raw);
    });
  </script>
</body>
</html>
