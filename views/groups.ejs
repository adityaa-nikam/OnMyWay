<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>My Groups — OnMyWay (OMW)</title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="min-h-screen bg-slate-950 text-slate-100 p-4 md:p-8 font-sans">
  <div class="max-w-4xl mx-auto">
    <!-- Top Navigation -->
    <header class="flex items-center justify-between pb-6 mb-8 border-b border-slate-800">
      <div class="flex items-center gap-3">
        <a href="/" class="flex items-center gap-2 group">
          <div class="w-10 h-10 rounded-xl bg-sky-500/10 border border-sky-500/20 flex items-center justify-center text-xl group-hover:scale-105 transition">
            ⚡
          </div>
          <div>
            <h1 class="text-xl font-extrabold text-white tracking-tight flex items-center gap-1.5">
              <span>OnMyWay</span>
              <span class="text-sky-400 font-mono text-sm">(OMW)</span>
            </h1>
            <p class="text-[11px] text-slate-400 font-medium">Share until you arrive.</p>
          </div>
        </a>
      </div>

      <div class="flex items-center gap-4">
        <div class="hidden sm:flex items-center gap-2 bg-slate-900 border border-slate-800 px-3 py-1.5 rounded-xl text-xs">
          <span class="w-2 h-2 rounded-full bg-emerald-400"></span>
          <span class="text-slate-300 font-medium"><%= user.displayName %></span>
        </div>
        <a href="/account" class="text-xs font-semibold text-slate-400 hover:text-white px-3 py-1.5 rounded-lg hover:bg-slate-900 transition">
          Account
        </a>
        <form action="/auth/logout" method="POST" class="inline">
          <button type="submit" class="text-xs font-semibold text-red-400 hover:text-red-300 px-3 py-1.5 rounded-lg hover:bg-red-950/30 transition">
            Sign Out
          </button>
        </form>
      </div>
    </header>

    <!-- Main Content Area -->
    <main>
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-6">
        <div>
          <h2 class="text-2xl font-bold text-white tracking-tight">Your Groups</h2>
          <p class="text-xs text-slate-400 mt-0.5">Persistent group coordination workspaces you belong to</p>
        </div>

        <div class="flex items-center gap-2">
          <button onclick="document.getElementById('modal-join').classList.remove('hidden')"
                  class="px-4 py-2 rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-200 text-xs font-semibold transition flex items-center gap-1.5">
            🔗 Join with Code
          </button>
          <button onclick="document.getElementById('modal-create').classList.remove('hidden')"
                  class="px-4 py-2 rounded-xl bg-sky-600 hover:bg-sky-500 text-white text-xs font-semibold shadow-lg shadow-sky-600/20 transition flex items-center gap-1.5">
            + New Group
          </button>
        </div>
      </div>

      <!-- Groups Grid -->
      <% if (groups.length === 0) { %>
        <div class="bg-slate-900/60 border border-slate-800/80 rounded-2xl p-12 text-center">
          <div class="text-4xl mb-3">👥</div>
          <h3 class="text-base font-bold text-white mb-1">No groups yet</h3>
          <p class="text-xs text-slate-400 max-w-sm mx-auto mb-6">
            Create your first persistent group to start sharing locations and messages with your friends, team, or family.
          </p>
          <button onclick="document.getElementById('modal-create').classList.remove('hidden')"
                  class="px-5 py-2.5 rounded-xl bg-sky-600 hover:bg-sky-500 text-white text-xs font-semibold shadow-lg shadow-sky-600/20 transition">
            Create a Group Now
          </button>
        </div>
      <% } else { %>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <% groups.forEach(function(g) { %>
            <div class="bg-slate-900 border border-slate-800 hover:border-slate-700 rounded-2xl p-5 transition flex flex-col justify-between">
              <div>
                <div class="flex items-start justify-between gap-2 mb-2">
                  <h3 class="text-base font-bold text-white truncate"><%= g.name %></h3>
                  <span class="text-[10px] font-bold uppercase tracking-wider px-2 py-0.5 rounded-md <%= g.role === 'owner' ? 'bg-amber-500/10 text-amber-400 border border-amber-500/20' : 'bg-slate-800 text-slate-400' %>">
                    <%= g.role %>
                  </span>
                </div>
                <div class="flex items-center gap-4 text-xs text-slate-400 mb-6">
                  <span>👥 <%= g.member_count %> member<%= g.member_count === 1 ? '' : 's' %></span>
                  <span>💬 <%= g.total_messages %> message<%= g.total_messages === 1 ? '' : 's' %></span>
                </div>
              </div>

              <div class="flex items-center justify-between pt-4 border-t border-slate-800/60">
                <span class="text-[11px] text-slate-500 font-mono">ID: <%= g.id.slice(0, 10) %>...</span>
                <a href="/groups/<%= g.id %>"
                   class="px-4 py-2 rounded-xl bg-sky-600/20 hover:bg-sky-600 text-sky-300 hover:text-white border border-sky-500/30 text-xs font-semibold transition flex items-center gap-1.5">
                  Open Workspace →
                </a>
              </div>
            </div>
          <% }); %>
        </div>
      <% } %>

      <!-- Ephemeral Quick Room Link -->
      <div class="mt-12 p-5 rounded-2xl bg-slate-900/40 border border-slate-800/60 flex flex-col sm:flex-row items-center justify-between gap-4">
        <div>
          <h4 class="text-xs font-bold uppercase tracking-wider text-slate-400 flex items-center gap-1.5">
            <span>⚡ Ephemeral Guest Mode</span>
          </h4>
          <p class="text-xs text-slate-500 mt-1">
            Need a one-time anonymous coordination room that leaves no trace in the database?
          </p>
        </div>
        <a href="/" class="px-4 py-2 rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-300 text-xs font-semibold transition shrink-0">
          Create Ephemeral Room
        </a>
      </div>
    </main>
  </div>

  <!-- Modal: Create Group -->
  <div id="modal-create" class="hidden fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/70 backdrop-blur-sm">
    <div class="bg-slate-900 border border-slate-800 rounded-2xl max-w-md w-full p-6 shadow-2xl">
      <div class="flex items-center justify-between mb-4">
        <h3 class="text-base font-bold text-white">Create New Group</h3>
        <button onclick="document.getElementById('modal-create').classList.add('hidden')" class="text-slate-400 hover:text-white">✕</button>
      </div>

      <form id="form-create-group" onsubmit="handleCreateGroup(event)" class="space-y-4">
        <div>
          <label class="block text-xs font-semibold text-slate-400 mb-1.5">Group Name</label>
          <input type="text" id="create-group-name" required placeholder="e.g. Weekend Trek / Roadtrip"
                 class="w-full bg-slate-950 border border-slate-800 rounded-xl px-4 py-2.5 text-sm text-white placeholder-slate-600 outline-none focus:border-sky-500" />
        </div>

        <div>
          <label class="block text-xs font-semibold text-slate-400 mb-1.5">Chat History Retention</label>
          <select id="create-group-retention" class="w-full bg-slate-950 border border-slate-800 rounded-xl px-4 py-2.5 text-sm text-white outline-none">
            <option value="30">Keep messages for 30 days</option>
            <option value="90">Keep messages for 90 days</option>
            <option value="365">Keep messages for 1 year</option>
            <option value="0">Never delete messages</option>
          </select>
        </div>

        <div class="flex justify-end gap-2 pt-2">
          <button type="button" onclick="document.getElementById('modal-create').classList.add('hidden')"
                  class="px-4 py-2 rounded-xl bg-slate-800 text-slate-300 text-xs font-semibold hover:bg-slate-700">
            Cancel
          </button>
          <button type="submit"
                  class="px-5 py-2 rounded-xl bg-sky-600 hover:bg-sky-500 text-white text-xs font-semibold shadow-lg shadow-sky-600/20">
            Create Group
          </button>
        </div>
      </form>
    </div>
  </div>

  <!-- Modal: Join Group with Code -->
  <div id="modal-join" class="hidden fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/70 backdrop-blur-sm">
    <div class="bg-slate-900 border border-slate-800 rounded-2xl max-w-md w-full p-6 shadow-2xl">
      <div class="flex items-center justify-between mb-4">
        <h3 class="text-base font-bold text-white">Join with Invite Code</h3>
        <button onclick="document.getElementById('modal-join').classList.add('hidden')" class="text-slate-400 hover:text-white">✕</button>
      </div>

      <form id="form-join-group" onsubmit="handleJoinGroup(event)" class="space-y-4">
        <div>
          <label class="block text-xs font-semibold text-slate-400 mb-1.5">Invite Link or Token Code</label>
          <input type="text" id="join-invite-token" required placeholder="Paste full link or token code"
                 class="w-full bg-slate-950 border border-slate-800 rounded-xl px-4 py-2.5 text-sm text-white placeholder-slate-600 outline-none focus:border-sky-500" />
        </div>

        <div class="flex justify-end gap-2 pt-2">
          <button type="button" onclick="document.getElementById('modal-join').classList.add('hidden')"
                  class="px-4 py-2 rounded-xl bg-slate-800 text-slate-300 text-xs font-semibold hover:bg-slate-700">
            Cancel
          </button>
          <button type="submit"
                  class="px-5 py-2 rounded-xl bg-sky-600 hover:bg-sky-500 text-white text-xs font-semibold shadow-lg shadow-sky-600/20">
            Join Group
          </button>
        </div>
      </form>
    </div>
  </div>

  <script>
    async function handleCreateGroup(e) {
      e.preventDefault();
      const name = document.getElementById('create-group-name').value.trim();
      const retention = document.getElementById('create-group-retention').value;
      if (!name) return;

      try {
        const res = await fetch('/api/groups', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            'X-CSRF-Token': '<%= csrfToken %>'
          },
          body: JSON.stringify({ name, messageRetentionDays: retention })
        });
        const data = await res.json();
        if (data.success) {
          window.location.href = '/groups/' + data.group.id;
        } else {
          alert(data.error || 'Failed to create group');
        }
      } catch (err) {
        alert('Network error while creating group');
      }
    }

    function handleJoinGroup(e) {
      e.preventDefault();
      let raw = document.getElementById('join-invite-token').value.trim();
      if (!raw) return;

      // Extract token if full URL was pasted
      if (raw.includes('/join-group/')) {
        raw = raw.split('/join-group/')[1].split(/[?#]/)[0];
      }
      window.location.href = '/join-group/' + encodeURIComponent(raw);
    }
  </script>
</body>
</html>
