<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Account Settings — OnMyWay (OMW)</title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="min-h-screen bg-slate-950 text-slate-100 p-4 md:p-8 font-sans">
  <div class="max-w-2xl mx-auto">
    <!-- Top Header -->
    <header class="flex items-center justify-between pb-6 mb-8 border-b border-slate-800">
      <div class="flex items-center gap-3">
        <a href="/groups" class="flex items-center gap-2 group">
          <div class="w-10 h-10 rounded-xl bg-sky-500/10 border border-sky-500/20 flex items-center justify-center text-xl group-hover:scale-105 transition">
            ⚡
          </div>
          <div>
            <h1 class="text-xl font-extrabold text-white tracking-tight flex items-center gap-1.5">
              <span>OnMyWay</span>
              <span class="text-sky-400 font-mono text-sm">(OMW)</span>
            </h1>
            <p class="text-[11px] text-slate-400 font-medium">Share until you arrive.</p>
          </div>
        </a>
      </div>

      <a href="/groups" class="px-4 py-2 rounded-xl bg-slate-800 hover:bg-slate-700 text-xs font-semibold text-slate-200 transition">
        ← Back to Groups
      </a>
    </header>

    <main class="space-y-6">
      <!-- Profile Card -->
      <div class="bg-slate-900 border border-slate-800 rounded-2xl p-6 shadow-xl">
        <h2 class="text-base font-bold text-white mb-4">Account Profile</h2>
        <div class="space-y-4">
          <div>
            <label class="block text-xs font-semibold text-slate-400 uppercase tracking-wider mb-1">Display Name</label>
            <div class="text-sm font-medium text-white bg-slate-950 px-4 py-2.5 rounded-xl border border-slate-800">
              <%= user.displayName %>
            </div>
          </div>
          <div>
            <label class="block text-xs font-semibold text-slate-400 uppercase tracking-wider mb-1">Email Address</label>
            <div class="text-sm font-medium text-white bg-slate-950 px-4 py-2.5 rounded-xl border border-slate-800 font-mono">
              <%= user.email %>
            </div>
          </div>
          <div>
            <label class="block text-xs font-semibold text-slate-400 uppercase tracking-wider mb-1">Active Group Memberships</label>
            <div class="text-sm font-medium text-sky-400 bg-slate-950 px-4 py-2.5 rounded-xl border border-slate-800">
              <%= groupsCount %> group<%= groupsCount === 1 ? '' : 's' %>
            </div>
          </div>
        </div>
      </div>

      <!-- Danger Zone: Account Deletion -->
      <div class="bg-red-950/20 border border-red-900/40 rounded-2xl p-6 shadow-xl">
        <h2 class="text-base font-bold text-red-400 mb-2">Danger Zone</h2>
        <p class="text-xs text-slate-400 mb-4">
          Permanently delete your OnMyWay account, active sessions, group memberships, and authored messages. This action is irreversible.
        </p>

        <button onclick="handleDeleteAccount()"
                class="px-5 py-2.5 rounded-xl bg-red-600/80 hover:bg-red-600 text-white text-xs font-semibold transition shadow-lg shadow-red-600/20">
          Delete My Account and All Data
        </button>
      </div>
    </main>
  </div>

  <script>
    async function handleDeleteAccount() {
      const confirmed = confirm("Are you absolutely sure you want to permanently delete your account and all data? This cannot be undone.");
      if (!confirmed) return;

      const doubleCheck = prompt("Type DELETE to confirm permanent account removal:");
      if (doubleCheck !== "DELETE") {
        alert("Account deletion cancelled.");
        return;
      }

      try {
        const res = await fetch('/api/account', {
          method: 'DELETE',
          headers: {
            'X-CSRF-Token': '<%= csrfToken %>'
          }
        });
        const data = await res.json();
        if (data.success) {
          alert("Your account and all associated data have been permanently removed.");
          window.location.href = '/';
        } else {
          alert(data.error || "Failed to delete account");
        }
      } catch (err) {
        alert("Network error while deleting account");
      }
    }
  </script>
</body>
</html>
