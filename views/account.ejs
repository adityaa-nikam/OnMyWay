<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Account Settings — OnMyWay (OMW)</title>
  <link rel="stylesheet" href="/css/app.css" />
  <link rel="manifest" href="/manifest.json" />
  <meta name="theme-color" content="#ffffff" />
</head>
<body class="min-h-screen bg-background text-foreground p-4 md:p-8 antialiased selection:bg-neutral-200">
  <div class="max-w-2xl mx-auto">
    <!-- Top Header -->
    <header class="flex items-center justify-between pb-6 mb-8 border-b border-border">
      <div class="flex items-center gap-3">
        <a href="/groups" class="flex items-center gap-2.5">
          <div class="w-8 h-8 rounded-md border border-border bg-muted flex items-center justify-center">
            <svg class="h-4 w-4 text-foreground" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon>
            </svg>
          </div>
          <div>
            <h1 class="text-base font-semibold text-foreground tracking-tight flex items-center gap-1.5">
              <span>OnMyWay</span>
            </h1>
            <p class="text-[11px] text-muted-foreground">Share until you arrive.</p>
          </div>
        </a>
      </div>

      <div class="flex items-center gap-2">
        <a href="/groups" class="inline-flex h-8 items-center justify-center rounded-md border border-input bg-background px-3 text-xs font-medium transition-colors hover:bg-accent hover:text-accent-foreground focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-ring">
          ← Back to Groups
        </a>
        <form action="/auth/logout" method="POST" class="inline">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
          <button type="submit" class="inline-flex h-8 items-center justify-center rounded-md border border-input bg-background px-3 text-xs font-medium text-muted-foreground hover:text-destructive hover:bg-muted transition-colors focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-ring">
            Sign Out
          </button>
        </form>
      </div>
    </header>

    <main class="space-y-6">
      <!-- Profile Card -->
      <div class="rounded-lg border border-border bg-card p-6 shadow-sm">
        <h2 class="text-sm font-semibold text-foreground mb-4">Account Profile</h2>
        <div class="space-y-4">
          <div>
            <label class="block text-xs font-medium text-muted-foreground mb-1.5">Display Name</label>
            <div class="text-sm font-medium text-foreground bg-muted/30 px-3.5 py-2 rounded-md border border-border">
              <%= user.displayName %>
            </div>
          </div>
          <div>
            <label class="block text-xs font-medium text-muted-foreground mb-1.5">Email Address</label>
            <div class="text-sm font-medium text-foreground bg-muted/30 px-3.5 py-2 rounded-md border border-border font-mono">
              <%= user.email %>
            </div>
          </div>
          <div>
            <label class="block text-xs font-medium text-muted-foreground mb-1.5">Active Group Memberships</label>
            <div class="text-sm font-medium text-foreground bg-muted/30 px-3.5 py-2 rounded-md border border-border">
              <%= groupsCount %> group<%= groupsCount === 1 ? '' : 's' %>
            </div>
          </div>
        </div>
      </div>

      <!-- Danger Zone: Account Deletion -->
      <div class="rounded-lg border border-destructive/40 bg-card p-6 shadow-sm">
        <div class="flex items-start justify-between gap-4">
          <div>
            <h2 class="text-sm font-semibold text-destructive mb-1">Danger Zone</h2>
            <p class="text-xs text-muted-foreground max-w-lg">
              Permanently delete your OnMyWay account, active sessions, group memberships, and authored messages. This action is irreversible.
            </p>
          </div>
          <button id="btn-delete-account" data-csrf="<%= csrfToken %>"
                  class="inline-flex h-9 items-center justify-center shrink-0 rounded-md border border-destructive bg-destructive/10 px-4 py-2 text-xs font-medium text-destructive transition-colors hover:bg-destructive hover:text-destructive-foreground focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-ring">
            Delete My Account
          </button>
        </div>
      </div>
    </main>
  </div>

  <script>
    document.getElementById('btn-delete-account')?.addEventListener('click', async function() {
      const csrf = this.getAttribute('data-csrf');
      const confirmed = confirm("Are you absolutely sure you want to permanently delete your account and all data? This cannot be undone.");
      if (!confirmed) return;

      const doubleCheck = prompt("Type DELETE to confirm permanent account removal:");
      if (doubleCheck !== "DELETE") {
        alert("Account deletion cancelled.");
        return;
      }

      try {
        const res = await fetch('/api/account', {
          method: 'DELETE',
          headers: {
            'X-CSRF-Token': csrf
          }
        });
        const data = await res.json();
        if (data.success) {
          alert("Your account and all associated data have been permanently removed.");
          window.location.href = '/';
        } else {
          alert(data.error || "Failed to delete account");
        }
      } catch (err) {
        alert("Network error while deleting account");
      }
    });
  </script>
</body>
</html>
