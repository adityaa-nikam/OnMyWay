<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Confirm Sign In — OnMyWay (OMW)</title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="min-h-screen bg-slate-950 text-slate-100 flex flex-col items-center justify-center p-4 font-sans">
  <div class="max-w-md w-full bg-slate-900 border border-slate-800 rounded-2xl p-8 shadow-2xl">
    <div class="text-center mb-6">
      <div class="inline-flex items-center justify-center w-14 h-14 rounded-2xl bg-sky-500/10 border border-sky-500/20 text-3xl mb-3">
        ⚡
      </div>
      <h1 class="text-2xl font-bold text-white tracking-tight">OnMyWay (OMW)</h1>
      <p class="text-xs text-slate-400 mt-1">Share until you arrive.</p>
    </div>

    <% if (valid) { %>
      <div class="bg-slate-800/60 border border-slate-700/60 rounded-xl p-5 mb-6 text-center">
        <p class="text-sm text-slate-300 mb-1">Confirming sign-in for:</p>
        <p class="text-sm font-semibold text-sky-400 font-mono"><%= email %></p>
      </div>

      <form method="POST" action="/auth/verify">
        <input type="hidden" name="token" value="<%= token %>" />
        <input type="hidden" name="returnUrl" value="<%= returnUrl %>" />

        <button type="submit"
                class="w-full py-3 px-4 rounded-xl bg-sky-600 hover:bg-sky-500 text-white font-semibold text-sm shadow-lg shadow-sky-600/20 transition active:scale-[0.98]">
          Sign In to OnMyWay →
        </button>
      </form>
      <p class="text-[11px] text-slate-500 text-center mt-4">
        🛡️ Protected against automated email link scanners. Token will be verified upon click.
      </p>
    <% } else { %>
      <div class="bg-red-950/40 border border-red-800/60 rounded-xl p-5 mb-6 text-center">
        <div class="text-2xl mb-2">❌</div>
        <p class="text-sm font-semibold text-red-300"><%= error %></p>
      </div>

      <div class="text-center">
        <a href="/login" class="inline-block py-2.5 px-5 rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-200 text-sm font-medium transition">
          Request a New Sign-In Link
        </a>
      </div>
    <% } %>
  </div>
</body>
</html>
