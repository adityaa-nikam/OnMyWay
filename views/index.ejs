<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>OnMyWay (OMW) — Share until you arrive</title>
  <link rel="stylesheet" href="/css/app.css" />
  <link rel="manifest" href="/manifest.json" />
  <meta name="theme-color" content="#ffffff" />
  <meta name="description" content="Private group chat and opt-in, time-limited live location sharing that automatically stops when you arrive." />
</head>
<body class="min-h-screen bg-background text-foreground flex flex-col font-sans antialiased selection:bg-neutral-200">
  <!-- Minimal Top Navigation -->
  <header class="w-full border-b border-border/80 bg-background/80 backdrop-blur-md sticky top-0 z-40 transition-all">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 h-14 flex items-center justify-between">
      <a href="/" class="flex items-center gap-2.5 group">
        <div class="w-7 h-7 rounded-md border border-border bg-muted/80 flex items-center justify-center transition-transform group-hover:scale-105">
          <svg class="h-4 w-4 text-foreground" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon>
          </svg>
        </div>
        <span class="text-sm font-semibold tracking-tight text-foreground">OnMyWay</span>
      </a>

      <div class="flex items-center gap-3">
        <a href="#guest-mode" class="text-xs font-medium text-muted-foreground hover:text-foreground transition-colors hidden sm:inline-block">
          Guest Mode
        </a>
        <a href="/groups" class="sleek-btn-primary h-8 px-3.5 text-xs">
          Sign In / Groups
        </a>
      </div>
    </div>
  </header>

  <main class="flex-1">
    <!-- Hero Section with Subtle Technical Dot-Grid -->
    <section class="relative pt-20 pb-20 text-center overflow-hidden">
      <!-- Background Dot Matrix Grid -->
      <div class="absolute inset-0 bg-grid-pattern bg-grid-mask pointer-events-none opacity-80" aria-hidden="true"></div>

      <div class="relative max-w-4xl mx-auto px-4 sm:px-6">
        <div class="inline-flex items-center gap-2 rounded-full border border-border/80 bg-background/90 backdrop-blur px-3.5 py-1.5 text-xs text-muted-foreground mb-8 shadow-xs hover:border-foreground/30 transition-colors">
          <span class="relative flex h-2 w-2">
            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-foreground opacity-30"></span>
            <span class="relative inline-flex rounded-full h-2 w-2 bg-foreground"></span>
          </span>
          <span class="font-medium text-foreground">Zero surveillance</span>
          <span class="text-border">·</span>
          <span>Automatic stop on arrival</span>
        </div>
        
        <h1 class="text-4xl sm:text-6xl md:text-7xl font-semibold tracking-tight text-foreground max-w-3xl mx-auto leading-[1.08]">
          Share until you arrive.
        </h1>
        
        <p class="mt-6 text-base sm:text-lg text-muted-foreground max-w-xl mx-auto font-normal leading-relaxed">
          Private group coordination and live location sharing that turns itself off when you reach your destination. No tracking trails, no background snooping.
        </p>

        <div class="mt-10 flex flex-col sm:flex-row items-center justify-center gap-3">
          <a href="/groups" class="sleek-btn-primary w-full sm:w-auto h-11 px-7 text-sm font-medium">
            Get Started with Groups
          </a>
          <a href="#guest-mode" class="sleek-btn-secondary w-full sm:w-auto h-11 px-7 text-sm font-medium">
            Quick Ephemeral Room
          </a>
        </div>

        <!-- Sleek Live Trip Mockup Preview -->
        <div class="mt-14 max-w-lg mx-auto text-left">
          <div class="sleek-card rounded-xl p-4 sm:p-5 bg-card/90 backdrop-blur border border-border/80">
            <div class="flex items-center justify-between pb-3 mb-3 border-b border-border/60">
              <div class="flex items-center gap-2.5">
                <span class="relative flex h-2.5 w-2.5">
                  <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-foreground opacity-40"></span>
                  <span class="relative inline-flex rounded-full h-2.5 w-2.5 bg-foreground"></span>
                </span>
                <span class="text-xs font-semibold text-foreground tracking-tight">Active Share · Weekend Meetup</span>
              </div>
              <span class="inline-flex items-center rounded-md bg-muted px-2 py-0.5 text-[10px] font-mono font-medium text-muted-foreground border border-border/50">
                GEOFENCE ARMED
              </span>
            </div>

            <div class="flex items-baseline justify-between mb-2">
              <div>
                <span class="text-2xl font-bold tracking-tight text-foreground">8 min</span>
                <span class="text-xs text-muted-foreground ml-1">estimated arrival</span>
              </div>
              <span class="text-xs font-mono text-muted-foreground">2.4 km away</span>
            </div>

            <!-- Progress Bar -->
            <div class="w-full bg-muted rounded-full h-1.5 mb-3 overflow-hidden">
              <div class="bg-foreground h-1.5 rounded-full transition-all" style="width: 72%;"></div>
            </div>

            <div class="flex items-center justify-between text-[11px] text-muted-foreground pt-1">
              <span class="flex items-center gap-1.5">
                <svg class="h-3.5 w-3.5 text-foreground" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
                Auto-destructs coordinates on arrival
              </span>
              <span class="font-mono text-[10px]">OSRM / GPS</span>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- 3-Step How It Works -->
    <section class="border-y border-border/80 bg-muted/20 py-20">
      <div class="max-w-5xl mx-auto px-4 sm:px-6">
        <div class="text-center mb-16">
          <h2 class="text-2xl sm:text-3xl font-semibold tracking-tight text-foreground">How it works</h2>
          <p class="text-sm text-muted-foreground mt-2">Calm, clear coordination in three simple steps.</p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          <!-- Step 1 -->
          <div class="sleek-card rounded-xl p-6">
            <div class="inline-block px-2 py-0.5 rounded text-[10px] font-mono font-semibold tracking-wider text-muted-foreground bg-muted border border-border/60 mb-4">
              01 / SET OFF
            </div>
            <h3 class="text-base font-semibold text-foreground mb-2">Set off</h3>
            <p class="text-xs text-muted-foreground leading-relaxed">
              Choose your duration—15 minutes, 1 hour, or until you reach your meetup destination. You choose exactly which groups can see you.
            </p>
          </div>

          <!-- Step 2 -->
          <div class="sleek-card rounded-xl p-6">
            <div class="inline-block px-2 py-0.5 rounded text-[10px] font-mono font-semibold tracking-wider text-muted-foreground bg-muted border border-border/60 mb-4">
              02 / FOLLOWED
            </div>
            <h3 class="text-base font-semibold text-foreground mb-2">Followed</h3>
            <p class="text-xs text-muted-foreground leading-relaxed">
              Your group sees a live dot with real-time ETA and automatic lateness notices. No perpetual surveillance—only active following while you commute.
            </p>
          </div>

          <!-- Step 3 -->
          <div class="sleek-card rounded-xl p-6">
            <div class="inline-block px-2 py-0.5 rounded text-[10px] font-mono font-semibold tracking-wider text-muted-foreground bg-muted border border-border/60 mb-4">
              03 / REACHED
            </div>
            <h3 class="text-base font-semibold text-foreground mb-2">Reached</h3>
            <p class="text-xs text-muted-foreground leading-relaxed">
              The moment you step inside the geofence or your timer elapses, location sharing terminates immediately. Your coordinates vanish from memory.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- Privacy Section -->
    <section class="py-20 max-w-5xl mx-auto px-4 sm:px-6">
      <div class="text-center mb-16">
        <h2 class="text-2xl font-semibold tracking-tight text-foreground">Built for peace of mind</h2>
        <p class="text-sm text-muted-foreground mt-1">Privacy guaranteed by code and cryptographic isolation.</p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8 text-center md:text-left">
        <div class="space-y-2">
          <div class="inline-flex h-9 w-9 items-center justify-center rounded-md border border-border bg-muted mb-2">
            <svg class="h-4 w-4 text-foreground" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <rect width="18" height="11" x="3" y="11" rx="2" ry="2"></rect>
              <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
            </svg>
          </div>
          <h3 class="text-sm font-semibold text-foreground">Off by default</h3>
          <p class="text-xs text-muted-foreground leading-relaxed">
            Your location is never tracked in the background without explicit initiation. You remain invisible until you hit Share.
          </p>
        </div>

        <div class="space-y-2">
          <div class="inline-flex h-9 w-9 items-center justify-center rounded-md border border-border bg-muted mb-2">
            <svg class="h-4 w-4 text-foreground" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="10"></circle>
              <polyline points="12 6 12 12 16 14"></polyline>
            </svg>
          </div>
          <h3 class="text-sm font-semibold text-foreground">Time-limited</h3>
          <p class="text-xs text-muted-foreground leading-relaxed">
            Every session enforces strict server-side boundaries. No forgotten active shares running indefinitely on remote servers.
          </p>
        </div>

        <div class="space-y-2">
          <div class="inline-flex h-9 w-9 items-center justify-center rounded-md border border-border bg-muted mb-2">
            <svg class="h-4 w-4 text-foreground" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <line x1="18" y1="6" x2="6" y2="18"></line>
              <line x1="6" y1="6" x2="18" y2="18"></line>
            </svg>
          </div>
          <h3 class="text-sm font-semibold text-foreground">Zero trails</h3>
          <p class="text-xs text-muted-foreground leading-relaxed">
            We store zero coordinate history. Once a share completes, past coordinates are discarded immediately with no breadcrumb logs.
          </p>
        </div>
      </div>
    </section>

    <!-- Ephemeral Guest Mode Section -->
    <section id="guest-mode" class="border-t border-border/80 bg-muted/15 py-20">
      <div class="max-w-xl mx-auto px-4 sm:px-6">
        <div class="sleek-card rounded-xl p-6 sm:p-8 bg-card border border-border/80">
          <div class="text-center mb-6">
            <div class="inline-flex h-9 w-9 items-center justify-center rounded-lg border border-border bg-muted/60 mb-3">
              <svg class="h-4 w-4 text-foreground" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="10"></circle>
                <line x1="2" y1="12" x2="22" y2="12"></line>
                <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path>
              </svg>
            </div>
            <h2 class="text-xl font-semibold tracking-tight text-foreground">Ephemeral Guest Mode</h2>
            <p class="text-xs text-muted-foreground mt-1.5 max-w-sm mx-auto">
              Need a quick, anonymous room that leaves no trace in any database?
            </p>
          </div>

          <!-- Active Room Detected State -->
          <div id="room-active-box" class="hidden mb-6 p-4 rounded-lg border border-border bg-muted/40 backdrop-blur">
            <div class="flex items-center justify-between mb-2">
              <span class="text-xs font-semibold text-foreground uppercase tracking-wider flex items-center gap-2">
                <span class="relative flex h-2 w-2">
                  <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-foreground opacity-40"></span>
                  <span class="relative inline-flex rounded-full h-2 w-2 bg-foreground"></span>
                </span>
                Active Room
              </span>
              <span id="room-badge" class="text-xs font-mono bg-background border border-border px-2.5 py-0.5 rounded-md text-foreground"></span>
            </div>
            <p class="text-xs text-muted-foreground mb-3">Share this invite link with your group:</p>
            <div class="flex gap-2 mb-4">
              <input id="invite-link-input" type="text" readonly
                     class="flex-1 h-9 bg-background border border-input px-3 rounded-md text-xs font-mono text-foreground select-all outline-none focus:ring-1 focus:ring-foreground" />
              <button id="copy-btn"
                      class="sleek-btn-secondary h-9 px-4 text-xs font-medium">
                Copy
              </button>
            </div>

            <a id="btn-enter-room" href="#"
               class="sleek-btn-primary w-full h-10 text-xs font-medium mb-2.5">
              Enter Workspace (Chat & Live Map)
            </a>

            <div class="grid grid-cols-2 gap-2">
              <a id="btn-enter-chat" href="#"
                 class="sleek-btn-secondary h-9 text-xs font-medium">
                Chat Only
              </a>
              <a id="btn-enter-location" href="#"
                 class="sleek-btn-secondary h-9 text-xs font-medium">
                Map Only
              </a>
            </div>
          </div>

          <!-- Actions -->
          <div class="space-y-4">
            <button id="create-room-btn"
                    class="sleek-btn-primary w-full h-10 text-xs font-medium">
              Start Quick Ephemeral Room
            </button>

            <div class="relative flex py-2 items-center">
              <div class="flex-grow border-t border-border"></div>
              <span class="flex-shrink mx-3 text-[10px] uppercase tracking-wider text-muted-foreground font-semibold">or join existing</span>
              <div class="flex-grow border-t border-border"></div>
            </div>

            <form id="join-form" class="space-y-3.5">
              <div>
                <label class="block text-xs font-medium text-foreground mb-1.5">Invite Link or Code</label>
                <input id="join-input" type="text" placeholder="Paste invite link or roomId..."
                       class="flex h-10 w-full rounded-md border border-input bg-transparent px-3 py-1 text-sm shadow-sm transition-all placeholder:text-muted-foreground focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-ring" />
              </div>
              <button type="submit"
                      class="sleek-btn-secondary w-full h-10 text-xs font-medium">
                Join Guest Room
              </button>
            </form>
          </div>

          <div id="status-msg" class="hidden mt-4 p-3 rounded-md text-xs text-center border"></div>
        </div>
      </div>
    </section>
  </main>

  <!-- Minimal Monochrome Footer -->
  <footer class="border-t border-border py-8 bg-background">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-muted-foreground">
      <div class="flex items-center gap-2">
        <span class="font-medium text-foreground">OnMyWay (OMW)</span>
        <span>·</span>
        <span>Share until you arrive.</span>
      </div>
      <div class="flex items-center gap-4">
        <a href="/groups" class="hover:text-foreground transition-colors">Groups</a>
        <a href="/ui-kit" class="hover:text-foreground transition-colors">Design System</a>
        <a href="#guest-mode" class="hover:text-foreground transition-colors">Guest Mode</a>
      </div>
    </div>
  </footer>

  <script>
    const params = new URLSearchParams(window.location.search);
    const existingRoomId = params.get('roomId');
    const existingToken = params.get('token');

    if (existingRoomId && existingToken) {
      showActiveRoom(existingRoomId, existingToken);
    }

    document.getElementById('create-room-btn')?.addEventListener('click', async function() {
      const btn = this;
      btn.disabled = true;
      btn.textContent = 'Generating Room...';
      try {
        const res = await fetch('/api/rooms', { method: 'POST' });
        const data = await res.json();
        if (data.success) {
          showActiveRoom(data.roomId, data.token);
          showMessage('Room created! Share the invite link with your group.', 'success');
        } else {
          showMessage('Failed to create room', 'error');
        }
      } catch (err) {
        showMessage('Network error while creating room', 'error');
      } finally {
        btn.disabled = false;
        btn.textContent = 'Start Quick Ephemeral Room';
      }
    });

    document.getElementById('copy-btn')?.addEventListener('click', function() {
      const input = document.getElementById('invite-link-input');
      navigator.clipboard.writeText(input.value).then(() => {
        const btn = document.getElementById('copy-btn');
        btn.textContent = 'Copied!';
        setTimeout(() => btn.textContent = 'Copy', 2000);
      });
    });

    document.getElementById('join-form')?.addEventListener('submit', function(e) {
      e.preventDefault();
      const raw = document.getElementById('join-input').value.trim();
      if (!raw) return;

      try {
        let url;
        if (raw.startsWith('http://') || raw.startsWith('https://')) {
          url = new URL(raw);
        } else if (raw.startsWith('?')) {
          url = new URL(window.location.origin + '/' + raw);
        } else {
          const parts = raw.split(/[:\s,]+/);
          if (parts.length >= 2) {
            url = new URL(`${window.location.origin}/?roomId=${encodeURIComponent(parts[0])}&token=${encodeURIComponent(parts[1])}`);
          } else {
            showMessage('Invalid invite link. Please provide a full invite URL.', 'error');
            return;
          }
        }

        const rId = url.searchParams.get('roomId');
        const rTok = url.searchParams.get('token');
        if (rId && rTok) {
          showActiveRoom(rId, rTok);
          showMessage('Joined room successfully! Choose Chat or Location above.', 'success');
        } else {
          showMessage('Missing roomId or token in invite URL', 'error');
        }
      } catch (err) {
        showMessage('Invalid URL format', 'error');
      }
    });

    function showActiveRoom(roomId, token) {
      const activeBox = document.getElementById('room-active-box');
      const badge = document.getElementById('room-badge');
      const linkInput = document.getElementById('invite-link-input');
      const roomBtn = document.getElementById('btn-enter-room');
      const chatBtn = document.getElementById('btn-enter-chat');
      const locBtn = document.getElementById('btn-enter-location');

      const origin = window.location.origin;
      const inviteUrl = `${origin}/room?roomId=${encodeURIComponent(roomId)}&token=${encodeURIComponent(token)}`;

      badge.textContent = `ID: ${roomId.slice(0, 8)}...`;
      linkInput.value = inviteUrl;
      roomBtn.href = `/room?roomId=${encodeURIComponent(roomId)}&token=${encodeURIComponent(token)}`;
      chatBtn.href = `/chat?roomId=${encodeURIComponent(roomId)}&token=${encodeURIComponent(token)}`;
      locBtn.href = `/location?roomId=${encodeURIComponent(roomId)}&token=${encodeURIComponent(token)}`;

      activeBox.classList.remove('hidden');
    }

    function showMessage(msg, type) {
      const el = document.getElementById('status-msg');
      el.textContent = msg;
      el.className = `mt-4 p-3 rounded-md text-xs text-center border ${
        type === 'success' ? 'bg-muted/40 text-foreground border-border' : 'bg-destructive/10 text-destructive border-destructive/20'
      }`;
      el.classList.remove('hidden');
    }
  </script>
</body>
</html>
