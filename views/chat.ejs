<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>OnMyWay (OMW) — Private Chat</title>
  <link rel="stylesheet" href="/css/chat.css">
  <script defer src="/socket.io/socket.io.js"></script>
  <script defer src="/js/chat.js"></script>
</head>
<body>
  <div style="display: flex; justify-content: space-between; align-items: center; padding: 12px 20px;">
    <a href="/" class="back">← Back to Hub</a>
    <div id="room-header-badge" style="font-family: monospace; font-size: 0.85rem; background: #f3f4f6; padding: 6px 12px; border-radius: 8px; border: 1px solid #e5e7eb; color: #374151;">
      Connecting to Room...
    </div>
  </div>

  <nav>
    <img src="/chatLOGO.png" class="logo" alt="chatapp Logo">
  </nav>

  <div class="container"></div>

  <div class="send">
    <form id="send-container">
      <input type="text" id="messageInp" placeholder="Enter your message here" maxlength="2000" autocomplete="off">
      <button class="btn" type="submit">Send</button>
    </form>
  </div>
</body>
</html>
